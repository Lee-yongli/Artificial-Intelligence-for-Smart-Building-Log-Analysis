.DS_Store
**/.DS_Store
**/.ipynb_checkpoints/

# Other raw or duplicated data remain local; the selected Floor 6 file is included.
Date Resource/
Artificial Intelligence for Smart-Building Log Analysis/Raw [Dd]ata/*
!Artificial Intelligence for Smart-Building Log Analysis/Raw data/2018Floor6.csv

# Large generated datasets. Recreate these from the notebook.
Artificial Intelligence for Smart-Building Log Analysis/outputs/*.csv.gz

# Week 6 ML-ready data and fitted preprocessing artifact are reproducible locally.
Artificial Intelligence for Smart-Building Log Analysis/outputs/floor6_zone1245_ml_ready/*.csv.gz
Artificial Intelligence for Smart-Building Log Analysis/outputs/floor6_zone1245_ml_ready/*.pkl
!Artificial Intelligence for Smart-Building Log Analysis/outputs/floor6_zone1245_ml_ready/floor6_zone1245_ml_ready_2018_jul01_sep01.csv.gz
!Artificial Intelligence for Smart-Building Log Analysis/outputs/floor6_zone1245_ml_ready/preprocessing_pipeline.pkl

# Local runtime artifacts.
__pycache__/
*.pyc
.env
.venv/
venv/

# Include the agreed Week 7 splits and September 6 data; ignore other generated data.
Artificial Intelligence for Smart-Building Log Analysis/outputs/week7_prediction_ready_dataset/data/*
!Artificial Intelligence for Smart-Building Log Analysis/outputs/week7_prediction_ready_dataset/data/prediction_ready_train.csv.gz
!Artificial Intelligence for Smart-Building Log Analysis/outputs/week7_prediction_ready_dataset/data/prediction_ready_validation.csv.gz
!Artificial Intelligence for Smart-Building Log Analysis/outputs/week7_prediction_ready_dataset/data/prediction_ready_test.csv.gz
!Artificial Intelligence for Smart-Building Log Analysis/outputs/week7_prediction_ready_dataset/data/prediction_ready_2018-09-06_from_raw.csv
!Artificial Intelligence for Smart-Building Log Analysis/outputs/week7_prediction_ready_dataset/data/prediction_ready_2018-09-06_from_raw.csv.gz
